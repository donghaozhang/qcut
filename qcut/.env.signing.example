# .env.signing.example — Apple Developer signing credentials for `bun run dist:mac`
#
# Copy this file to .env.signing (gitignored), fill in the real values, then:
#   set -a; source .env.signing; set +a
#   bun run dist:mac
#
# DO NOT commit .env.signing — it contains secrets.

# Apple Account email that owns the Apple Developer Program membership.
# For Quriosity Pty Ltd this is the Account Holder's Apple ID.
APPLE_ID=apple-account@example.com

# App-specific password generated at https://account.apple.com → Sign-In and
# Security → App-Specific Passwords. Format: xxxx-xxxx-xxxx-xxxx.
# Used by Apple's notarytool to authenticate notarization submissions.
APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx

# 10-character Apple Developer Team ID. View at developer.apple.com/account
# → Membership Details. For Quriosity Pty Ltd this is JQ3Q27U24X (publicly
# embedded in the signed binary, not a secret).
APPLE_TEAM_ID=JQ3Q27U24X
