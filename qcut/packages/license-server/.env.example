# Supabase (required for database)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...your-service-role-key

# Stripe (required for payments)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
BETTER_AUTH_SECRET=replace-with-better-auth-secret

# Stripe subscription price IDs
STRIPE_PRO_MONTHLY_PRICE_ID=price_xxx
STRIPE_PRO_YEARLY_PRICE_ID=price_xxx
STRIPE_TEAM_MONTHLY_PRICE_ID=price_xxx
STRIPE_TEAM_YEARLY_PRICE_ID=price_xxx

# Stripe top-up credit pack price IDs
STRIPE_TOPUP_STARTER_PRICE_ID=price_xxx
STRIPE_TOPUP_STANDARD_PRICE_ID=price_xxx
STRIPE_TOPUP_PRO_PRICE_ID=price_xxx
STRIPE_TOPUP_MEGA_PRICE_ID=price_xxx

# Mock mode: set to "true" to bypass Stripe/Supabase (local dev)
MOCK_MODE=false

# Payment runtime controls
PAYMENTS_WEB_BASE_URL=https://quriosity.com.au
PAYMENTS_CHECKOUT_ENABLED=true
PAYMENTS_WEBHOOK_ENABLED=true
PAYMENTS_CANARY_ONLY=false
PAYMENTS_EMAIL_ALLOWLIST=internal1@example.com,internal2@example.com

# Extra CORS origins (comma-separated). Optional.
CORS_ALLOWED_ORIGINS=

# Legacy (kept for Drizzle ORM compatibility)
DATABASE_URL=postgresql://user:pass@host:5432/qcut
