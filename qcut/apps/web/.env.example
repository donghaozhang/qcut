# QCut Environment Variables Example
# Copy this file to .env for development

# FAL.ai API Key for AI image editing & upscaling
# Same key powers text-to-image, edit, and upscale jobs.
# Get your API key from: https://fal.ai/dashboard
VITE_FAL_API_KEY=your_fal_api_key_here

# Google Gemini API Key for AI caption transcription
# ⚠️ WARNING: This is for DEVELOPMENT ONLY! Not secure - visible in bundled code!
# For production: Use Settings → API Keys (encrypted storage)
# Get your Gemini API key from: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Sound Library Integration
# Get your API key from https://freesound.org/help/developers/
VITE_FREESOUND_API_KEY=your_freesound_api_key_here

# Audio CDN catalog manifest (optional). When set, the audio library merges
# remote tracks from this manifest with the bundled catalog. See
# apps/web/audio-cdn/README.md for publishing.
VITE_AUDIO_CDN_MANIFEST_URL=https://kbrtxitvavpuimuihppz.supabase.co/storage/v1/object/public/audio-cdn/manifest.json

# Internal Sound Effects Lab. With no local manifest path, the client requests
# the private manifest from the license server and stays hidden unless the
# signed-in account is allowlisted.
VITE_QCUT_ENABLE_SOUND_EFFECTS_LAB=false
VITE_QCUT_SOUND_EFFECTS_LAB_MANIFEST_PATH=
VITE_LICENSE_SERVER_URL=https://qcut-license-server.zdhpeter.workers.dev
